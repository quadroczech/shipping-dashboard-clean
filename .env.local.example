# ─── Supabase ─────────────────────────────────────────────────────────────────
# Získáte na: https://supabase.com → váš projekt → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service role key — pro migraci tabulek; NIKDY neexponujte klientovi
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ─── Lokia WMS API ────────────────────────────────────────────────────────────
# DŮLEŽITÉ: Tato hodnota je tajná — NIKDY ji necommitujte do veřejného repozitáře!
# Docs: https://www.lokiawms-app.com/wms-erp/swagger/ui/index
LOKIA_API_USER=your-lokia-api-user
LOKIA_API_PASSWORD=your-lokia-api-password

# ─── Cron ─────────────────────────────────────────────────────────────────────
# Optional: protects GET /api/cron/* endpoints. Vercel Cron jobs set
# Authorization: Bearer $CRON_SECRET automatically.
CRON_SECRET=

# ─── Anthropic (AI) ───────────────────────────────────────────────────────────
# Pro vyčítání PDF ceníků dopravců na /dopravci (POST /api/parse-pricelist).
# Klíč získáte na https://console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=sk-ant-...
